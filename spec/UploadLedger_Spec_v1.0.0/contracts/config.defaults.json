{
  "specVersion": "1.0.0",
  "schemaVersion": 1,
  "protocolVersion": 1,
  "workingName": "留底",
  "slug": "upload-ledger",
  "browser": {
    "family": "Chromium",
    "minimumChromeVersion": "120",
    "primaryOS": "macOS",
    "incognito": "not_allowed",
    "topFrameOnly": true
  },
  "capture": {
    "maxFileBytes": 52428800,
    "maxBatchBytes": 209715200,
    "maxBatchFiles": 100,
    "rawChunkBytes": 262144,
    "maxWireMessageBytes": 524288,
    "maxInFlightChunksPerFile": 1,
    "maxActiveFilesPerDocument": 1,
    "maxActiveFilesGlobal": 2,
    "ackTimeoutMs": 10000,
    "retryBackoffMs": [
      250,
      1000,
      3000
    ],
    "sessionIdleExpiryMs": 120000,
    "sessionAbsoluteExpiryMs": 600000,
    "terminalSessionRetentionMs": 86400000,
    "sourceLossGraceMs": 15000,
    "dropCaptureDefault": false,
    "requireTrustedEvent": true
  },
  "storage": {
    "defaultBudgetBytes": 1073741824,
    "minimumBudgetBytes": 104857600,
    "maximumBudgetBytes": 5368709120,
    "warningFraction": 0.8,
    "estimatedFreeSpaceMarginBytes": 52428800,
    "automaticRetentionEnabled": false,
    "cleanupAlarmMinutes": 1,
    "cleanupMaxChunksPerTick": 200,
    "localEncryption": "none"
  },
  "privacy": {
    "initialSiteAllowlist": [],
    "globalPaused": false,
    "pageLocationMode": "origin_path",
    "stripQuery": true,
    "stripFragment": true,
    "savePageTitle": true,
    "savePageBody": false,
    "saveLocalAbsolutePath": false,
    "networkTelemetry": false,
    "cloudSync": false,
    "externalAI": false,
    "clipboardCapture": false
  },
  "limits": {
    "fileNameChars": 1024,
    "pageTitleChars": 256,
    "pageLocationChars": 4096,
    "userLabelChars": 120,
    "noteChars": 4000,
    "tagChars": 32,
    "tagsPerRecord": 10,
    "batchBeginRatePerDocumentPerMinute": 30,
    "textPreviewBytes": 2097152,
    "textDiffBytesPerSide": 1048576,
    "imageMaxDecodedPixels": 40000000,
    "pdfPreviewMaxPages": 500,
    "pdfPreviewTimeoutMs": 15000,
    "listPageSize": 100,
    "previewCacheBytes": 67108864
  },
  "backup": {
    "format": "upload-ledger-backup",
    "formatVersion": 1,
    "maxManifestBytes": 20971520,
    "maxRecords": 10000,
    "maxAuditEvents": 100000,
    "maxObjectCount": 10000,
    "maxArchiveUncompressedBytes": 5368709120,
    "maxObjectBytes": 52428800,
    "blobFallbackMaxBytes": 209715200,
    "jobLeaseMs": 900000,
    "encrypted": false
  },
  "excludedFileNames": [
    ".env",
    ".env.*",
    "id_rsa",
    "id_dsa",
    "id_ecdsa",
    "id_ed25519",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.kdbx"
  ],
  "locale": {
    "default": "zh-CN",
    "supported": [
      "zh-CN",
      "en-GB"
    ]
  }
}
